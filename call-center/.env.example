# ── AI model (free, no Google account needed) ───────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint works.
# Default: Ollama running locally (https://ollama.com) — 100% free, runs on your machine.
#   1. Install Ollama   2. Run: ollama pull llama3.2
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3.2"
# Only needed for hosted providers (Groq, OpenRouter, etc). Leave empty for Ollama / LM Studio.
LLM_API_KEY=""
# Twilio waits ~15s for a webhook reply; keep this below that.
LLM_TIMEOUT_MS="12000"

# ── Server ──────────────────────────────────────────────────────────────────
PORT="3000"

# ── Twilio voice (optional) ─────────────────────────────────────────────────
# Voice used for <Say> on phone calls.
TWILIO_VOICE="Polly.Joanna"
# If set, callers who ask for a human are transferred to this number.
HUMAN_FORWARD_NUMBER=""

# ── Outbound dialer, reminders & live takeover ──────────────────────────────
# Dashboard password (username "admin"). On a hosted server the dialer stays
# locked until this is set, so strangers can't make calls on your account.
ADMIN_PASSWORD=""
# From https://console.twilio.com (Account Info box on the home page)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Your Twilio phone number in +1XXXXXXXXXX format. Used as caller ID.
TWILIO_FROM_NUMBER=""
# Public https address of this server (Render fills this in automatically).
# Needed when running on your own computer behind a tunnel.
PUBLIC_BASE_URL=""
# Where contacts, scripts and appointments are saved. On Render use a disk: /var/data
DATA_DIR="data"
# Set to "false" only if Twilio webhooks are wrongly rejected (see README).
TWILIO_VALIDATE_SIGNATURE="true"
# Country code used for numbers without one (1 = US/Canada).
DEFAULT_COUNTRY_CODE="1"

# ── Optional: Google Calendar + Google Meet links ──────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
